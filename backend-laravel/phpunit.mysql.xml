<?xml version="1.0" encoding="UTF-8"?>
<!--
    Pruebas opcionales contra un MySQL 8.4 DESECHABLE. No forman parte de phpunit.xml
    ni de la CI. Requisitos y salvaguardas: tests/MySql/bootstrap.php y docs/mysql-traslado.md.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/MySql/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="MySql">
            <directory>tests/MySql</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
</phpunit>
