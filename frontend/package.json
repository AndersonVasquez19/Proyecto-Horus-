{
  "name": "horus-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test:deploy": "node --test tests/deployment.test.mjs",
    "test:errors": "node --experimental-strip-types --test tests/public-errors.test.mjs",
    "smoke:auth": "node scripts/smoke-auth.cjs",
    "smoke:unsaved": "npm run build && node scripts/smoke-unsaved.cjs",
    "test:return-path": "node --experimental-strip-types --test tests/return-path.test.mjs",
    "test:list-records": "node --experimental-strip-types --test tests/list-records.test.mjs",
    "test:attention-merge": "node --experimental-strip-types --test tests/attention-merge.test.mjs",
    "test:mail-outcome": "node --experimental-strip-types --test tests/mail-outcome.test.mjs",
    "test:message-export": "node --experimental-strip-types --test tests/message-export.test.mjs",
    "test:notify": "node --experimental-strip-types --test tests/notify.test.mjs",
    "test:session-access": "node --experimental-strip-types --test tests/session-access.test.mjs",
    "smoke:messages-table": "npm run build && node scripts/smoke-messages-table.cjs",
    "smoke:message-detail": "npm run build && node scripts/smoke-message-detail.cjs",
    "smoke:attention-conflicts": "npm run build && node scripts/smoke-attention-conflicts.cjs",
    "smoke:mail-attempts": "npm run build && node scripts/smoke-mail-attempts.cjs",
    "smoke:message-center": "npm run build && node scripts/smoke-message-center.cjs",
    "smoke:attention-save": "npm run build && node scripts/smoke-attention-save.cjs",
    "smoke:panel-sections": "npm run build && node scripts/smoke-panel-sections.cjs",
    "smoke:message-responsive": "npm run build && node scripts/smoke-message-responsive.cjs",
    "smoke:quote-origin": "npm run build && node scripts/smoke-quote-origin.cjs",
    "smoke:panel-toasts": "npm run build && node scripts/smoke-panel-toasts.cjs",
    "smoke:chatbot": "npm run build && node scripts/smoke-chatbot.cjs",
    "smoke:session-access": "npm run build && node scripts/smoke-session-access.cjs"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^6.23.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.10",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.10"
  },
  "engines": {
    "node": "22.x"
  }
}
