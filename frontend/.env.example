# Local development uses the Vite proxy.
VITE_API_BASE_URL=/api

# In the Vercel frontend project, set the full public backend URL instead:
# VITE_API_BASE_URL=https://your-backend.vercel.app/api
# VITE_* values are public and embedded during build. Never put secrets here.

# Contenido público: NestJS por defecto. Para leerlo de Laravel (solo GET de cursos, servicios,
# preguntas frecuentes, galería, convenios y ajustes), definir ambas variables:
# VITE_CONTENT_PROVIDER=laravel
# VITE_CONTENT_API_BASE_URL=https://academico.example.com/api/contenido
