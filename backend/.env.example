PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=horus_db
DB_USER=root
DB_PASS=your_database_password

# Proveedor de correo: resend o gmail (si se omite, gmail). No hay fallback automático entre proveedores. Ver backend/MAIL.md.
MAIL_PROVIDER=gmail

# Gmail (solo si MAIL_PROVIDER=gmail)
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password

# Resend (solo si MAIL_PROVIDER=resend). Valores ilustrativos: nunca subas claves reales.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM="Horus Group <noreply@tu-dominio-verificado.example>"

# Opcional: destinatario interno de avisos (contacto y reclamos). Por defecto, el remitente.
# MAIL_NOTIFY_TO=equipo@example.com

JWT_SECRET=your_jwt_secret_min_32_characters

# Prisma does not synchronize the schema on startup. Use db:init for an empty database and db:migrate for existing installations.
DB_SYNC=false
NODE_ENV=development

# Swagger (/api/docs): enabled by default in development; disabled in production.
# In production only SWAGGER_ENABLED=true enables it, and then it requires HTTPS plus an active administrator (HTTP Basic). Never put credentials in the URL.
# SWAGGER_ENABLED=false

# Production: exact frontend origins separated by commas; no trailing slash.
# CORS_ORIGINS=https://your-frontend.vercel.app
# Local defaults are used when NODE_ENV is not production.
CORS_ORIGINS=

# Enable TLS when required by your hosted MySQL provider.
DB_SSL=false
# Optional CA certificate; use literal \n between PEM lines.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Optional pinned MySQL RSA PUBLIC key from a trusted administrator (PEM, literal \n allowed).
# Required for caching_sha2_password without TLS after a cold restart.
# DB_RSA_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Only the IPs/CIDRs of trusted reverse proxies; empty means no trust.
TRUSTED_PROXY_CIDRS=

# Production uploads require a persistent volume mounted here.
# UPLOAD_DIR=/data/uploads
# Remote integration tests only on an explicitly authorized test server.
# ALLOW_INTEGRATION_DB=true
