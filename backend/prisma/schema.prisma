  presentacion String @default("normal") @db.VarChar(30)
  nombre_corto String? @db.VarChar(80)
  destacado String? @db.VarChar(100)
  dato_principal String? @db.VarChar(40)
  dato_secundario String? @db.VarChar(100)
  etiquetas String? @db.Text
  icono String? @db.VarChar(30)
  color String @default("indigo") @db.VarChar(20)
  orden Int @default(0)
  alcance String? @db.Text
  imagen_url String? @db.VarChar(2048)
  estado ServicioEstado @default(borrador)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
  @@map("servicios")
}

model PreguntaFrecuente {
