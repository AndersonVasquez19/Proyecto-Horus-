generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}

// Roles administrativos (deben coincidir con ADMIN_ROLES de src/permissions/roles.ts; lo comprueba una prueba).
enum AdminRol {
  GERENTE_GENERAL
  COORDINADORA_INSTITUCIONAL
  SECRETARIA
}

model AdminUser {
  id Int @id @default(autoincrement())
  nombre String @db.VarChar(100)
  email String @unique(map: "email") @db.VarChar(254)
  password String @db.VarChar(255)
  activo Boolean @default(true)
  session_version Int @default(1)
  // NULL = cuenta sin rol asignado. Sin valor predeterminado: ningún rol se concede de forma implícita. Todavía no lo consulta ninguna ruta.
  rol AdminRol?
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
  @@map("admin_users")
}

model AdminItem {
  id Int @id @default(autoincrement())
  titulo String @db.VarChar(150)
  descripcion String @db.Text
  categoria String @default("general") @db.VarChar(50)
  estado String @default("activo") @db.VarChar(20)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
  @@map("admin_items")
}

model Curso {
  origen_original String? @unique(map: "cursos_origen_original") @db.VarChar(150)
  id Int @id @default(autoincrement())
  titulo String @db.VarChar(160)
  slug String @unique(map: "slug") @db.VarChar(180)
  descripcion String @db.Text
  tipo CursoTipo
  modalidad CursoModalidad?
  duracion String? @db.VarChar(120)
  area String? @db.VarChar(80)
  certificacion String? @db.VarChar(150)
  icono String? @db.VarChar(30)
  color String @default("indigo") @db.VarChar(20)
  orden Int @default(0)
  temario String? @db.Text
  imagen_url String? @db.VarChar(2048)
  fecha_inicio DateTime? @db.DateTime(0)
  estado CursoEstado @default(borrador)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
  @@map("cursos")
}

model Servicio {
  origen_original String? @unique(map: "servicios_origen_original") @db.VarChar(150)
  id Int @id @default(autoincrement())
  titulo String @db.VarChar(160)
  slug String @unique(map: "slug") @db.VarChar(180)
  descripcion String @db.Text
  categoria ServicioCategoria
  presentacion String @default("normal") @db.VarChar(30)
  nombre_corto String? @db.VarChar(80)
  destacado String? @db.VarChar(100)
  dato_principal String? @db.VarChar(40)
  dato_secundario String? @db.VarChar(100)
  etiquetas String? @db.Text
  icono String? @db.VarChar(30)
  color String @default("indigo") @db.VarChar(20)
  orden Int @default(0)
  alcance String? @db.Text
  imagen_url String? @db.VarChar(2048)
  estado ServicioEstado @default(borrador)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
  @@map("servicios")
}

model PreguntaFrecuente {
  id Int @id @default(autoincrement())
  pregunta String @db.VarChar(300)
  respuesta String @db.Text
  categoria String @db.VarChar(100)
  orden Int @default(0)
  estado PreguntaFrecuenteEstado @default(borrador)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
  @@map("preguntas_frecuentes")
}

model Contacto {
  id Int @id @default(autoincrement())
  nombre String @db.VarChar(255)
  email String @db.VarChar(255)
  telefono String @db.VarChar(255)
  asunto String @db.VarChar(255)
  mensaje String @db.Text
  estado String @default("nuevo") @db.VarChar(255)
  origen String @default("web") @db.VarChar(20)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
  cotizaciones Cotizacion[]
  seguimientos AttentionRecord[]
  @@map("contactos")
}

model Cotizacion {
  id Int @id @default(autoincrement())
  numero String @unique(map: "numero") @db.VarChar(60)
  cliente String @db.VarChar(160)
  email String @db.VarChar(254)
  telefono String @db.VarChar(30)
  documento String @db.VarChar(30)
  direccion String @db.VarChar(300)
  emisor String @db.VarChar(160)
  datos_emisor String @db.VarChar(500)
  moneda String @db.VarChar(3)
  validez DateTime @db.Date
  condiciones String @db.Text
  conceptos Json
  subtotal Decimal @db.Decimal(14,2)
  descuento Decimal @db.Decimal(14,2)
  tasa Decimal @db.Decimal(5,2)
  impuesto Decimal @db.Decimal(14,2)
  total Decimal @db.Decimal(14,2)
  estado String @default("borrador") @db.VarChar(20)
  contacto_id Int?
  contacto Contacto? @relation(fields: [contacto_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([contacto_id], map: "cotizaciones_contacto_id_idx")
  revision Int @default(1)
  historial Json
  idempotencia_clave String? @unique(map: "cotizaciones_idempotencia_clave") @db.VarChar(128)
  idempotencia_huella String? @db.Char(64)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
  @@map("cotizaciones")
}

model GaleriaItem {
  origen_original String? @unique(map: "galeria_origen_original") @db.VarChar(150)
  id Int @id @default(autoincrement())
  titulo String @db.VarChar(150)
  descripcion String? @db.Text
  categoria String @default("general") @db.VarChar(50)
  imagen_url String @db.VarChar(500)
  orden Int? @default(0)
  activo Boolean? @default(true)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
  @@map("galeria_items")
}

model Newsletter {
  consent_at DateTime? @db.DateTime(0)
  id Int @id @default(autoincrement())
  email String @unique(map: "email") @db.VarChar(254)
  interes String @default("novedades") @db.VarChar(100)
  activo Boolean? @default(true)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
  @@map("newsletter_subscribers")
}

model Reclamacion {
  id Int @id @default(autoincrement())
  numero_reclamo String? @unique(map: "numero_reclamo") @db.VarChar(255)
  nombres String @db.VarChar(255)
  apellidos String @db.VarChar(255)
  tipo_doc String? @db.VarChar(255)
  num_doc String? @db.VarChar(255)
  email String @db.VarChar(255)
  telefono String @db.VarChar(255)
  direccion String? @db.VarChar(255)
  tipo_registro ReclamacionTipo_registro
  area String @db.VarChar(255)
  fecha_incidente DateTime @db.Date
  descripcion_bien String @db.Text
  detalle_reclamo String @db.Text
  acepta_comunicaciones Boolean? @default(false)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
  seguimientos AttentionRecord[]
  @@map("reclamaciones")
}

model Setting {
  id Int @id @default(autoincrement())
  clave String @unique(map: "clave") @db.VarChar(50)
  valor String @db.Text
  descripcion String? @db.VarChar(200)
  grupo String @default("general") @db.VarChar(50)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
  @@map("empresa_settings")
}

enum CursoTipo {
  curso
  capacitacion
}

enum CursoModalidad {
  presencial
  virtual
  hibrida
}

enum CursoEstado {
  borrador
  publicado
  archivado
}

enum ServicioCategoria {
  cableado
  camaras
  soporte
  asesoramiento
}

enum ServicioEstado {
  borrador
  publicado
  archivado
}

enum PreguntaFrecuenteEstado {
  borrador
  publicado
  archivado
}

enum ReclamacionTipo_registro {
  reclamo
  queja
}



model AttentionRecord {
  contacto_id Int?
  reclamacion_id Int?
  contacto Contacto? @relation(fields: [contacto_id], references: [id], onDelete: Restrict)
  reclamacion Reclamacion? @relation(fields: [reclamacion_id], references: [id], onDelete: Restrict)
  id Int @id @default(autoincrement())
  recurso String @db.VarChar(20)
  registro_id Int
  estado String @default("nuevo") @db.VarChar(20)
  responsable String @default("") @db.VarChar(100)
  notas String @db.Text
  respuesta String @db.Text
  revision Int @default(1)
  historial Json
  updatedAt DateTime @updatedAt @db.DateTime(0)
  @@unique([recurso, registro_id], map: "attention_record_resource")
  @@map("attention_records")
}
model RateLimitBucket {
  id String @id @db.VarChar(64)
  count Int
  expiresAt DateTime @db.DateTime(0)
  @@index([expiresAt], map: "rate_limit_expires_idx")
  @@map("rate_limit_buckets")
}

model Convenio {
  id Int @id @default(autoincrement())
  nombre String @db.VarChar(160)
  sigla String? @db.VarChar(50)
  logo_url String? @db.VarChar(2048)
  descripcion_corta String @db.Text
  descripcion_completa String? @db.Text
  informacion_adicional String? @db.Text
  orden Int @default(0)
  visible Boolean @default(false)
  origen_local String? @unique(map: "convenios_origen_local") @db.VarChar(150)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
  fotos ConvenioFoto[]
  @@index([visible, orden], map: "convenios_visible_orden_idx")
  @@index([orden], map: "convenios_orden_idx")
  @@map("convenios")
}

model ConvenioFoto {
  id Int @id @default(autoincrement())
  convenio_id Int
  convenio Convenio @relation(fields: [convenio_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  imagen_url String @db.VarChar(2048)
  orden Int @default(0)
  createdAt DateTime @default(now()) @db.DateTime(0)
  @@index([convenio_id, orden], map: "convenio_fotos_convenio_orden_idx")
  @@map("convenio_fotos")
}

model ChatbotInteraccion {
  id Int @id @default(autoincrement())
  modo String @db.VarChar(10)
  resuelta Boolean
  fuentes Int @default(0)
  createdAt DateTime @default(now()) @db.DateTime(0)
  @@index([createdAt], map: "chatbot_interacciones_created_idx")
  @@map("chatbot_interacciones")
}

model ChatbotPreguntaSinRespuesta {
  id Int @id @default(autoincrement())
  huella String @unique(map: "chatbot_sin_respuesta_huella") @db.Char(64)
  pregunta String @db.VarChar(500)
  veces Int @default(1)
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
  @@index([updatedAt], map: "chatbot_sin_respuesta_updated_idx")
  @@map("chatbot_preguntas_sin_respuesta")
}
