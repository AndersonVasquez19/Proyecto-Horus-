generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}

// Roles administrativos (deben coincidir con ADMIN_ROLES de src/permissions/roles.ts; lo comprueba una prueba).
enum AdminRol {
  GERENTE_GENERAL
  COORDINADORA_INSTITUCIONAL
  SECRETARIA
}

model AdminUser {
  id Int @id @default(autoincrement())
  nombre String @db.VarChar(100)
  email String @unique(map: "email") @db.VarChar(254)
  password String @db.VarChar(255)
  activo Boolean @default(true)
  session_version Int @default(1)
  // NULL = cuenta sin rol asignado. Sin valor predeterminado: ningún rol se concede de forma implícita. Todavía no lo consulta ninguna ruta.
  rol AdminRol?
  createdAt DateTime @default(now()) @db.DateTime(0)
  updatedAt DateTime @updatedAt @db.DateTime(0)
  matriculas_confirmadas Matricula[] @relation("MatriculaConfirmadoPor")
  certificados_emitidos Certificado[] @relation("CertificadoEmitidoPor")
  certificados_anulados Certificado[] @relation("CertificadoAnuladoPor")
  @@map("admin_users")
}

enum AdminAuditoriaOrigen {
  panel
  terminal
}

enum AdminAuditoriaOperacion {
  cuenta_creada
  cuenta_activada
  cuenta_desactivada
  rol_asignado
  rol_retirado
}

enum AdminAuditoriaResultado {
  aplicado
  rechazado
}

// Registro de solo inserción de los cambios de cuentas y privilegios (M-4). Se escribe en la misma transacción que el cambio.
// Sin claves foráneas a propósito: el historial no impide ni sigue el borrado de una cuenta. No guarda correos, contraseñas,
// tokens ni IP: la cuenta se identifica por su id (los id de InnoDB no se reutilizan).
model AdminAuditoria {
  id Int @id @default(autoincrement())
  createdAt DateTime @default(now()) @db.DateTime(3)
  origen AdminAuditoriaOrigen
  actor_id Int? // cuenta que hizo el cambio desde el panel; NULL desde la terminal
  operador String? @db.VarChar(100) // terminal: quién ejecutó el script (declarado)
  cuenta_id Int
  operacion AdminAuditoriaOperacion
  rol_anterior AdminRol?
  rol_nuevo AdminRol?
  activo_anterior Boolean?
  activo_nuevo Boolean?
  resultado AdminAuditoriaResultado
  motivo String? @db.VarChar(200)
  @@index([cuenta_id, createdAt], map: "admin_auditoria_cuenta_idx")
  @@index([actor_id, createdAt], map: "admin_auditoria_actor_idx")
  @@map("admin_auditoria")
}

model AdminItem {
  id Int @id @default(autoincrement())
  titulo String @db.VarChar(150)
  descripcion String @db.Text
  categoria String @default("general") @db.VarChar(50)
  estado String @default("activo") @db.VarChar(20)
