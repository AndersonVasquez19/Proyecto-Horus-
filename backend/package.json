{
  "name": "horus-backend-nestjs",
  "version": "1.0.0",
  "description": "Backend NestJS para Horus Group SRL",
  "author": "Horus Group",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run prisma:generate && nest build",
    "start": "nest start --path tsconfig.dev.json",
    "start:dev": "nest start --watch --path tsconfig.dev.json",
    "start:debug": "nest start --debug --watch --path tsconfig.dev.json",
    "start:prod": "node dist/main",
    "test": "node --test --test-concurrency=1 -r ./test/isolate-env.cjs -r ts-node/register test/*.test.ts",
    "db:migrate": "node scripts/migrate.cjs",
    "admin:create": "node scripts/create-admin.cjs",
    "admin:assign-role": "node scripts/assign-role.cjs",
    "db:init": "node scripts/init-database.cjs",
    "prisma:generate": "node scripts/prisma-generate.cjs",
    "postinstall": "npm run prisma:generate",
    "db:check": "node scripts/check-database.cjs",
    "db:backup": "node scripts/backup.cjs",
    "db:restore": "node scripts/restore.cjs",
    "chatbot:purge": "node scripts/purge-chatbot.cjs",
    "uploads:backup": "node scripts/backup-uploads.cjs",
    "uploads:restore": "node scripts/restore-uploads.cjs",
    "content:restore": "node scripts/restore-original.cjs",
    "convenios:import": "node scripts/import-convenios.cjs",
    "test:integration": "npm run build && node --test test/prisma.integration.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/adapter-mariadb": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "helmet": "^8.3.0",
    "mysql2": "^3.12.0",
    "nodemailer": "10.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "0.17.6",
    "prisma": "6.19.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "@nestjs/platform-express": {
      "multer": "2.5.0",
      "qs": "6.16.0"
    },
    "@nestjs/common": { "file-type": "21.3.4" },
    "@prisma/adapter-mariadb": { "mariadb": "3.5.4" },
    "@prisma/config": { "deepmerge-ts": "8.0.2" },
    "lodash": "4.18.1",
    "js-yaml@^4.0.0": "4.3.2",
    "ajv@^8.0.0": "8.20.0",
    "picomatch@^4.0.0": "4.0.7",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^2.0.0": "2.1.7",
    "@nestjs/cli": { "glob": "10.5.0", "webpack": "5.112.2" },
    "external-editor": { "tmp": "0.2.7" }
  }
}
