# Ejemplo para docker-compose.local.yml. Copia a ".env.docker" (ignorado por Git) y sustituye TODOS los valores.
# Los valores de abajo son ficticios: no los uses tal cual y no pongas aquí credenciales de producción.
# Genera un JWT_SECRET con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Contraseña de root de MySQL (solo accesible dentro de la red de Docker).
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root-local

# Base y usuario de la aplicación (se crean al iniciar el volumen de MySQL por primera vez).
DB_NAME=horus_local
DB_USER=horus
DB_PASS=cambia-esta-clave-app-local

# Mínimo 32 caracteres.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LOCAL_DE_AL_MENOS_32_CARACTERES

# Puerto local del sitio (se publica solo en 127.0.0.1).
HORUS_WEB_PORT=8081

# Swagger en /api/docs (solo para clientes locales). Por defecto apagado.
SWAGGER_ENABLED=false
